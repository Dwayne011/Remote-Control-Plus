<?xml version="1.0" encoding="utf-8"?>
<!-- Layout B: two button rails, then a D-pad that uses the full height at the end edge.
     48 + 6 + 48 + 6 + 180 = 288dp, inside the ~292dp the decorated template leaves. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/remote_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end|center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

        <!-- Outer rail: switch device / Volume + / Mute / Volume - -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="196dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_rail_container"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ImageButton
                    android:id="@+id/btn_device_switcher"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_surface"
                    android:contentDescription="Switch device"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_swap_20"
                    android:tint="@color/n_on_surface" />
            </FrameLayout>
            <ImageButton
                android:id="@+id/btn_vol_up"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ripple_item"
                android:contentDescription="Volume Up"
                android:src="@drawable/ic_volume_up_20"
                android:tint="@color/n_on_surface" />
            <ImageButton
                android:id="@+id/btn_vol_mute"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ripple_item"
                android:contentDescription="Mute"
                android:src="@drawable/ic_volume_off_20"
                android:tint="@color/n_on_surface_variant" />
            <ImageButton
                android:id="@+id/btn_vol_down"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ripple_item"
                android:contentDescription="Volume Down"
                android:src="@drawable/ic_volume_down_20"
                android:tint="@color/n_on_surface" />
        </LinearLayout>

        <!-- Inner rail: Power / Back / Home / Play-Pause -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="196dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_rail_container"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ImageButton
                    android:id="@+id/btn_power"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_power"
                    android:contentDescription="Power"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_power_24"
                    android:tint="@color/n_on_error_container" />
            </FrameLayout>
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ripple_item"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back_20"
                android:tint="@color/n_on_surface" />
            <ImageButton
                android:id="@+id/btn_home"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ripple_item"
                android:contentDescription="Home"
                android:src="@drawable/ic_home_20"
                android:tint="@color/n_on_surface" />
            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ripple_item"
                android:contentDescription="Play or Pause"
                android:src="@drawable/ic_play_pause_20"
                android:tint="@color/n_on_surface" />
        </LinearLayout>

        <!-- D-pad with OK -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/bg_dpad_ring">

            <ImageButton
                android:id="@+id/btn_dpad_up"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/bg_ripple_circle"
                android:contentDescription="Up"
                android:src="@drawable/ic_keyboard_arrow_up_24"
                android:tint="@color/n_on_surface" />
            <ImageButton
                android:id="@+id/btn_dpad_down"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_ripple_circle"
                android:contentDescription="Down"
                android:src="@drawable/ic_keyboard_arrow_down_24"
                android:tint="@color/n_on_surface" />
            <ImageButton
                android:id="@+id/btn_dpad_left"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_ripple_circle"
                android:contentDescription="Left"
                android:src="@drawable/ic_keyboard_arrow_left_24"
                android:tint="@color/n_on_surface" />
            <ImageButton
                android:id="@+id/btn_dpad_right"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_ripple_circle"
                android:contentDescription="Right"
                android:src="@drawable/ic_keyboard_arrow_right_24"
                android:tint="@color/n_on_surface" />

            <TextView
                android:id="@+id/btn_dpad_ok"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_primary"
                android:clickable="true"
                android:contentDescription="Select"
                android:focusable="true"
                android:gravity="center"
                android:text="OK"
                android:textColor="@color/n_on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>
</LinearLayout>
